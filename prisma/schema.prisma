generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    SUPERADMIN
    ADMIN
    USER
}

enum ApartmentListingType {
    SOTISH
    IJARA
    SHERIK_KERAK
    ALMASHISH
}

enum ApartmentDealStatus {
    ACTIVE
    SOLD
}

enum LayoutStatus {
    AVAILABLE
    SOLD_OUT
    COMING_SOON
}

enum BannerLocation {
    HOME_TOP
    HOME_MIDDLE
    HOME_BOTTOM
    OTHER
}

enum SalaryType {
    HOURLY
    DAILY
    MONTHLY
    PROJECT
}

enum LeadType {
    APARTMENT
    COMPLEX
    MASTER
    CALLBACK
    SEARCH_RECOVERY
    OTHER
}

enum LeadStatus {
    NEW
    CONTACTED
    QUALIFIED
    WON
    LOST
}

enum SearchIntentType {
    APARTMENT
    MASTER
    OTHER
}

enum SearchSurveyStatus {
    FOUND
    NOT_FOUND
    STILL_SEARCHING
}

enum ComplexInterestType {
    VIEW
    LIKE
    REQUEST_INFO
}

enum DevicePlatform {
    ANDROID
    IOS
    WEB
    UNKNOWN
}

model User {
    id                    Int                    @id @default(autoincrement())
    phone                 String                 @unique
    password              String?
    firstName             String?
    lastName              String?
    address               String?
    latitude              Float?
    longitude             Float?
    role                  UserRole               @default(USER)
    regionId              Int?
    region                Region?                @relation(fields: [regionId], references: [id], onDelete: Cascade)
    isBlocked             Boolean                @default(false) @map("is_blocked")
    blockedAt             DateTime?              @map("blocked_at")
    isArchived            Boolean                @default(false) @map("is_archived")
    archivedAt            DateTime?              @map("archived_at")
    masterProfile         MasterProfile?
    apartments            Apartment[]
    ratings               Rating[]
    apartmentLikes        ApartmentLike[]
    apartmentViews        ApartmentView[]
    savedMasterProfiles   MasterProfileSave[]
    masterProfileViews    MasterProfileView[]
    masterProfileContacts MasterProfileContact[]
    companyViews          CompanyView[]
    leads                 Lead[]
    searchSessions        SearchSession[]
    complexInterests      ComplexInterest[]
    createdAt             DateTime               @default(now()) @map("created_at")
    updatedAt             DateTime               @updatedAt @map("updated_at")
    userDevices           UserDevice[]
    notifications         Notification[]
}

model Company {
    id          Int           @id @default(autoincrement())
    name        String
    phone       String        @unique
    password    String?
    logo        String?
    description String?
    website     String?
    isVerified  Boolean       @default(false)
    isActive    Boolean       @default(true) @map("is_active")
    complexes   Complex[]
    views       CompanyView[]
    leads       Lead[]
    viewCount   Int           @default(0) @map("view_count")
    createdAt   DateTime      @default(now()) @map("created_at")
    updatedAt   DateTime      @updatedAt @map("updated_at")

    @@map("companies")
}

model Complex {
    id                Int               @id @default(autoincrement())
    nameUz            String            @map("name_uz")
    nameUzCyrl        String            @map("name_uz_cyrl")
    nameRu            String            @map("name_ru")
    descriptionUz     String?           @map("description_uz")
    descriptionUzCyrl String?           @map("description_uz_cyrl")
    descriptionRu     String?           @map("description_ru")
    address           String
    images            String[]
    companyId         Int
    company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
    regionId          Int
    region            Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
    layouts           ApartmentLayout[]
    apartments        Apartment[]
    leads             Lead[]
    interests         ComplexInterest[]
    latitude          Float?
    longitude         Float?
    createdAt         DateTime          @default(now()) @map("created_at")
    updatedAt         DateTime          @updatedAt @map("updated_at")

    @@map("complexes")
}

model ApartmentLayout {
    id         Int          @id @default(autoincrement())
    complexId  Int
    complex    Complex      @relation(fields: [complexId], references: [id], onDelete: Cascade)
    roomCount  Int
    area       Float
    priceMin   Float?
    priceMax   Float?
    images     String[]
    status     LayoutStatus @default(AVAILABLE)
    totalUnits Int          @default(1)
    apartments Apartment[]
    createdAt  DateTime     @default(now()) @map("created_at")
    updatedAt  DateTime     @updatedAt @map("updated_at")

    @@map("apartment_layouts")
}

model Apartment {
    id                Int                  @id @default(autoincrement())
    titleUz           String               @map("title_uz")
    titleUzCyrl       String               @map("title_uz_cyrl")
    titleRu           String               @map("title_ru")
    descriptionUz     String?              @map("description_uz")
    descriptionUzCyrl String?              @map("description_uz_cyrl")
    descriptionRu     String?              @map("description_ru")
    price             Float
    area              Float
    roomCount         Int
    floor             Int?
    totalFloors       Int?
    landArea          Float?
    isCottage         Boolean              @default(false)
    images            String[]
    listingType       ApartmentListingType @default(SOTISH)
    dealStatus        ApartmentDealStatus  @default(ACTIVE)
    soldAt            DateTime?            @map("sold_at")
    regionId          Int
    region            Region               @relation(fields: [regionId], references: [id], onDelete: Cascade)
    categoryId        Int
    category          ApartmentCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    address           String
    sellerId          Int?
    seller            User?                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
    complexId         Int?
    complex           Complex?             @relation(fields: [complexId], references: [id], onDelete: Cascade)
    layoutId          Int?
    layout            ApartmentLayout?     @relation(fields: [layoutId], references: [id], onDelete: Cascade)
    likes             ApartmentLike[]
    views             ApartmentView[]
    leads             Lead[]
    interests         ComplexInterest[]
    likeCount         Int                  @default(0) @map("like_count")
    viewCount         Int                  @default(0) @map("view_count")
    createdAt         DateTime             @default(now()) @map("created_at")
    updatedAt         DateTime             @updatedAt @map("updated_at")

    @@map("apartments")
}

model ApartmentLike {
    id          Int       @id @default(autoincrement())
    userId      Int
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    apartmentId Int
    apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
    createdAt   DateTime  @default(now()) @map("created_at")

    @@unique([userId, apartmentId])
    @@map("apartment_likes")
}

model ApartmentView {
    id          Int       @id @default(autoincrement())
    userId      Int?
    user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
    apartmentId Int
    apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
    createdAt   DateTime  @default(now()) @map("created_at")

    @@map("apartment_views")
}

model CompanyView {
    id        Int      @id @default(autoincrement())
    userId    Int?
    user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    companyId Int
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @map("created_at")

    @@map("company_views")
}

model ApartmentCategory {
    id         Int         @id @default(autoincrement())
    nameUz     String      @unique @map("name_uz")
    nameUzCyrl String      @unique @map("name_uz_cyrl")
    nameRu     String      @unique @map("name_ru")
    apartments Apartment[]
    createdAt  DateTime    @default(now()) @map("created_at")
    updatedAt  DateTime    @updatedAt @map("updated_at")

    @@map("apartment_categories")
}

model JobCategory {
    id                      Int                        @id @default(autoincrement())
    nameUz                  String                     @unique @map("name_uz")
    nameUzCyrl              String                     @unique @map("name_uz_cyrl")
    nameRu                  String                     @unique @map("name_ru")
    isActive                Boolean                    @default(true) @map("is_active")
    isArchived              Boolean                    @default(false) @map("is_archived")
    archivedAt              DateTime?                  @map("archived_at")
    masterProfileCategories MasterProfileJobCategory[]
    createdAt               DateTime                   @default(now()) @map("created_at")
    updatedAt               DateTime                   @updatedAt @map("updated_at")

    @@map("job_categories")
}

model MasterProfile {
    id           Int                        @id @default(autoincrement())
    userId       Int                        @unique
    user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
    bio          String?
    experience   Int
    skills       String[]
    portfolios   String[]
    isAvailable  Boolean                    @default(true)
    salary       Float?
    salaryType   SalaryType?                @map("salary_type")
    rating       Float                      @default(0)
    ratings      Rating[]
    categories   MasterProfileJobCategory[]
    savedBy      MasterProfileSave[]
    views        MasterProfileView[]
    contacts     MasterProfileContact[]
    leads        Lead[]
    savedCount   Int                        @default(0) @map("saved_count")
    viewCount    Int                        @default(0) @map("view_count")
    contactCount Int                        @default(0) @map("contact_count")
    createdAt    DateTime                   @default(now()) @map("created_at")
    updatedAt    DateTime                   @updatedAt @map("updated_at")

    @@map("master_profiles")
}

model MasterProfileJobCategory {
    id              Int           @id @default(autoincrement())
    masterProfileId Int           @map("master_profile_id")
    masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
    jobCategoryId   Int           @map("job_category_id")
    jobCategory     JobCategory   @relation(fields: [jobCategoryId], references: [id], onDelete: Cascade)
    createdAt       DateTime      @default(now()) @map("created_at")

    @@unique([masterProfileId, jobCategoryId])
    @@map("master_profile_job_categories")
}

model MasterProfileSave {
    id              Int           @id @default(autoincrement())
    userId          Int
    user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    masterProfileId Int           @map("master_profile_id")
    masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
    createdAt       DateTime      @default(now()) @map("created_at")

    @@unique([userId, masterProfileId])
    @@map("master_profile_saves")
}

model MasterProfileView {
    id              Int           @id @default(autoincrement())
    userId          Int?
    user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    masterProfileId Int           @map("master_profile_id")
    masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
    createdAt       DateTime      @default(now()) @map("created_at")

    @@map("master_profile_views")
}

model MasterProfileContact {
    id              Int           @id @default(autoincrement())
    userId          Int
    user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    masterProfileId Int           @map("master_profile_id")
    masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
    createdAt       DateTime      @default(now()) @map("created_at")

    @@unique([userId, masterProfileId])
    @@map("master_profile_contacts")
}

model Region {
    id                Int         @id @default(autoincrement())
    nameUz            String      @map("name_uz")
    nameUzCyrl        String      @map("name_uz_cyrl")
    nameRu            String      @map("name_ru")
    countryNameUz     String?     @default("O'zbekiston") @map("country_name_uz")
    countryNameUzCyrl String?     @default("Ўзбекистон") @map("country_name_uz_cyrl")
    countryNameRu     String?     @default("Узбекистан") @map("country_name_ru")
    parentId          Int?        @map("parent_id")
    parent            Region?     @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children          Region[]    @relation("RegionHierarchy")
    users             User[]
    complexes         Complex[]
    apartments        Apartment[]
    createdAt         DateTime    @default(now()) @map("created_at")
    updatedAt         DateTime    @updatedAt @map("updated_at")

    @@map("regions")
}

model Rating {
    id              Int           @id @default(autoincrement())
    score           Int
    comment         String?
    userId          Int
    user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    masterProfileId Int
    masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
    createdAt       DateTime      @default(now()) @map("created_at")
    updatedAt       DateTime      @updatedAt @map("updated_at")

    @@unique([userId, masterProfileId])
    @@map("ratings")
}

model Banner {
    id        Int            @id @default(autoincrement())
    image     String
    link      String?
    location  BannerLocation @default(OTHER)
    isActive  Boolean        @default(true)
    createdAt DateTime       @default(now()) @map("created_at")
    updatedAt DateTime       @updatedAt @map("updated_at")

    @@map("banners")
}

model Lead {
    id               Int                 @id @default(autoincrement())
    type             LeadType
    status           LeadStatus          @default(NEW)
    surveyStatus     SearchSurveyStatus?
    source           String?
    fullName         String              @map("full_name")
    phone            String
    address          String?
    preferredAddress String?             @map("preferred_address")
    budgetMin        Float?              @map("budget_min")
    budgetMax        Float?              @map("budget_max")
    downPayment      Float?              @map("down_payment")
    message          String?
    otherDetails     Json?               @map("other_details")
    searchSnapshot   Json?               @map("search_snapshot")
    isOpened         Boolean             @default(false) @map("is_opened")
    openedAt         DateTime?           @map("opened_at")
    openedBy         String?             @map("opened_by")
    userId           Int?                @map("user_id")
    user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
    companyId        Int?                @map("company_id")
    company          Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
    complexId        Int?                @map("complex_id")
    complex          Complex?            @relation(fields: [complexId], references: [id], onDelete: SetNull)
    apartmentId      Int?                @map("apartment_id")
    apartment        Apartment?          @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
    masterProfileId  Int?                @map("master_profile_id")
    masterProfile    MasterProfile?      @relation(fields: [masterProfileId], references: [id], onDelete: SetNull)
    searchSessionId  Int?                @unique @map("search_session_id")
    searchSession    SearchSession?      @relation(fields: [searchSessionId], references: [id], onDelete: SetNull)
    createdAt        DateTime            @default(now()) @map("created_at")
    updatedAt        DateTime            @updatedAt @map("updated_at")

    @@map("leads")
}

model SearchSession {
    id           Int                 @id @default(autoincrement())
    intentType   SearchIntentType    @map("intent_type")
    query        Json
    resultsCount Int                 @default(0) @map("results_count")
    surveyStatus SearchSurveyStatus?
    notes        String?
    fullName     String?             @map("full_name")
    phone        String?
    address      String?
    userId       Int?                @map("user_id")
    user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
    lead         Lead?
    createdAt    DateTime            @default(now()) @map("created_at")
    updatedAt    DateTime            @updatedAt @map("updated_at")

    @@map("search_sessions")
}

model ComplexInterest {
    id          Int                 @id @default(autoincrement())
    type        ComplexInterestType @default(VIEW)
    note        String?
    userId      Int?                @map("user_id")
    user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
    complexId   Int                 @map("complex_id")
    complex     Complex             @relation(fields: [complexId], references: [id], onDelete: Cascade)
    apartmentId Int?                @map("apartment_id")
    apartment   Apartment?          @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
    createdAt   DateTime            @default(now()) @map("created_at")

    @@map("complex_interests")
}

model DataAccessAudit {
    id                Int      @id @default(autoincrement())
    entityType        String   @map("entity_type")
    entityId          Int      @map("entity_id")
    action            String
    actorType         String   @map("actor_type")
    actorId           Int?     @map("actor_id")
    actorLabel        String?  @map("actor_label")
    description       String?
    payload           Json?
    telegramMessageId Int?     @map("telegram_message_id")
    createdAt         DateTime @default(now()) @map("created_at")

    @@map("data_access_audits")
}

model BackupLog {
    id                Int      @id @default(autoincrement())
    kind              String
    telegramMessageId Int?     @map("telegram_message_id")
    createdAt         DateTime @default(now()) @map("created_at")

    @@map("backup_logs")
}

model UserDevice {
    id         Int            @id @default(autoincrement())
    userId     Int            @map("user_id")
    user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    deviceId   String         @map("device_id")
    deviceName String?        @map("device_name")
    platform   DevicePlatform @default(UNKNOWN)
    fcmToken   String         @map("fcm_token")
    isActive   Boolean        @default(true) @map("is_active")
    lastSeenAt DateTime       @default(now()) @map("last_seen_at")
    createdAt  DateTime       @default(now()) @map("created_at")
    updatedAt  DateTime       @updatedAt @map("updated_at")

    @@unique([userId, deviceId])
    @@map("user_devices")
}

model Notification {
    id             Int       @id @default(autoincrement())
    userId         Int       @map("user_id")
    user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    title          String
    body           String
    data           Json?
    isRead         Boolean   @default(false) @map("is_read")
    readAt         DateTime? @map("read_at")
    deliveredCount Int       @default(0) @map("delivered_count")
    failedCount    Int       @default(0) @map("failed_count")
    createdAt      DateTime  @default(now()) @map("created_at")
    updatedAt      DateTime  @updatedAt @map("updated_at")

    @@map("notifications")
}
