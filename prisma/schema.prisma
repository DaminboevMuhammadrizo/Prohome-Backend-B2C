generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  ADMIN
  SELLER
  MASTER
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum JobStatus {
  ACTIVE
  INACTIVE
}

enum ImgType {
  MOBILE
  DESKTOP
  TABLET
}

enum ApartmentStatus {
  IJARA
  SOTISH
}

model Region {
  id                BigInt   @id @default(autoincrement())
  nameUz            String   @map("name_uz")
  nameUzCyrl        String   @map("name_uz_cyrl")
  nameRu            String   @map("name_ru")
  countryNameUz     String   @map("country_name_uz")
  countryNameUzCyrl String   @map("country_name_uz_cyrl")
  countryNameRu     String   @map("country_name_ru")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("regions")
}

model User {
  id        BigInt      @id @default(autoincrement())
  firstName String?
  lastName  String?
  age       Int?
  gender    Gender?
  phone     String      @unique
  email     String?
  regionId  BigInt?
  role      UserRole
  status    UserStatus? @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  region        Region?        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  masterProfile MasterProfile?
  masterRatings MasterRating[]
  apartments    Apartment[]

  @@index([regionId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model SalaryType {
  id         BigInt   @id @default(autoincrement())
  nameUz     String   @unique @map("name_uz")
  nameUzCyrl String   @unique @map("name_uz_cyrl")
  nameRu     String   @unique @map("name_ru")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  masterProfiles MasterProfile[]

  @@map("salary_types")
}

model MasterProfile {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @unique
  experience   Int
  salary       Int
  salaryTypeId BigInt
  address      String?  @map("adress")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryType SalaryType     @relation(fields: [salaryTypeId], references: [id], onDelete: Cascade)
  masterJobs MasterJob[]
  ratings    MasterRating[]

  @@index([salaryTypeId])
  @@map("master_profiles")
}

model Job {
  id         BigInt    @id @default(autoincrement())
  nameUz     String    @unique @map("name_uz")
  nameUzCyrl String    @unique @map("name_uz_cyrl")
  nameRu     String    @unique @map("name_ru")
  status     JobStatus
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  masterJobs MasterJob[]

  @@map("jobs")
}

model MasterJob {
  id           BigInt   @id @default(autoincrement())
  masterInfoId BigInt   @map("masterIId")
  jobId        BigInt
  experience   Int
  desc         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  masterProfile MasterProfile @relation(fields: [masterInfoId], references: [id], onDelete: Cascade)
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([masterInfoId])
  @@index([jobId])
  @@map("master_jobs")
}

model MasterRating {
  id              BigInt   @id @default(autoincrement())
  rating          Int
  desc            String?
  masterProfileId BigInt
  userId          BigInt
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([masterProfileId])
  @@index([userId])
  @@map("master_ratings")
}

model Banner {
  id        BigInt   @id @default(autoincrement())
  img       String
  imgType   ImgType
  link      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model ApartmentType {
  id         BigInt   @id @default(autoincrement())
  nameUz     String   @unique @map("name_uz")
  nameUzCyrl String   @unique @map("name_uz_cyrl")
  nameRu     String   @unique @map("name_ru")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  apartments Apartment[]

  @@map("apartment_types")
}

model Apartment {
  id              BigInt          @id @default(autoincrement())
  addressUz       String          @map("adress_uz")
  addressUzCyrl   String          @map("adress_uz_cyrl")
  addressRu       String          @map("adress_ru")
  regionId        BigInt
  roomCount       Int?
  descUz          String?         @map("desc_uz")
  descUzCyrl      String?         @map("desc_uz_cyrl")
  descRu          String?         @map("desc_ru")
  titleUz         String          @map("title_uz")
  titleUzCyrl     String          @map("title_uz_cyrl")
  titleRu         String          @map("title_ru")
  img             String[]
  area            Float
  pricePerMetr    Float
  price           Float?
  apartmentTypeId BigInt          @map("apartemtnTypeId")
  apartmentStatus ApartmentStatus
  sellerId        BigInt
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  apartmentType ApartmentType @relation(fields: [apartmentTypeId], references: [id], onDelete: Cascade)
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([apartmentTypeId])
  @@index([apartmentStatus])
  @@index([regionId])
  @@map("apartments")
}
